APP_NAME=bootok-admin
# 生产环境必须设置为 false（控制异常信息是否带堆栈细节）
APP_DEBUG=true
# 跨域白名单：* 为反射任意来源（仅开发），生产配置具体域名，逗号分隔
CORS_ORIGINS=*
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bootok
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=
# JWT 密钥（必填：请更换为任意随机长字符串，如 32 位 hex）
JWT_KEY=
# JWT 签发者
JWT_ISS=bootok-admin-s
# JWT 接收者
JWT_AUD=bootok-admin-c
# JWT 验证宽容时间（秒）
JWT_LEEWAY=10
# ACCESS_TOKEN 有效期（秒）
ACCESS_TOKEN_EXP=7200

# ---- 以下为可选配置（不配置则使用默认值）----

# 部署单元：all=管理端+用户端+计划任务（默认）/ client=仅用户端 / crontab=仅计划任务
# SERVER_ROLE=all
# 管理端监听地址
# ADMIN_LISTEN=http://0.0.0.0:8787
# 用户端监听地址
# CLIENT_LISTEN=http://0.0.0.0:8788
# 存储驱动：local（默认，本地 public 目录）/ oss
# STORAGE_DRIVER=local
