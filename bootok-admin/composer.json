{
    "name": "bootok/bootok",
    "type": "project",
    "keywords": [
        "admin",
        "dashboard",
        "webman",
        "crud",
        "permission",
        "ssl",
        "acme"
    ],
    "homepage": "https://gitee.com/hellobin-cn/bootok",
    "license": "MIT",
    "description": "通用后台管理脚手架：模型注解驱动，一个模型即完整资源。",
    "authors": [
        {
            "name": "hellobin",
            "email": "zhangbin1126@126.com",
            "homepage": "https://gitee.com/hellobin-cn",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "zhangbin1126@126.com",
        "issues": "https://gitee.com/hellobin-cn/bootok/issues",
        "source": "https://gitee.com/hellobin-cn/bootok"
    },
    "require": {
        "bootok/acme": "^1.0",
        "bootok/http": "^1.0",
        "firebase/php-jwt": "^7.1",
        "illuminate/events": "^12.64",
        "illuminate/pagination": "^12.64",
        "monolog/monolog": "^2.0",
        "php": ">=8.5",
        "php-di/php-di": "^7.1",
        "phpoffice/phpspreadsheet": "^5.0",
        "ramsey/uuid": "^4.9",
        "robmorgan/phinx": "^0.16",
        "symfony/var-dumper": "^7.4",
        "vlucas/phpdotenv": "^5.6",
        "webman/cache": "^2.1",
        "webman/console": "^2.2",
        "webman/database": "^2.1",
        "webman/redis": "^2.1",
        "workerman/crontab": "^1.0",
        "workerman/webman-framework": "^2.1",
        "phpseclib/phpseclib": "^3",
        "symfony/mailer": "^8.1"
    },
    "suggest": {
        "ext-event": "For better performance. "
    },
    "autoload": {
        "psr-4": {
            "": "./",
            "app\\": "./app",
            "App\\": "./app",
            "app\\View\\Components\\": "./app/view/components"
        },
        "files": [
            "./support/functions.php"
        ]
    },
    "scripts": {
        "post-package-install": [
            "support\\Plugin::install"
        ],
        "post-package-update": [
            "support\\Plugin::install"
        ],
        "pre-package-uninstall": [
            "support\\Plugin::uninstall"
        ],
        "test": "phpunit --colors=never"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^11"
    }
}
